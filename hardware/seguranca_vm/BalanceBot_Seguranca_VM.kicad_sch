(text "J107: dois contatos NA secos da supervisao externa; abrem na falha." (at 344.17 167.64 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "124502df-d7ba-43fe-ab30-1396f81eacde"))
(text "J110: botao local momentaneo NA. S12 -> botao -> espelhos NC -> S34." (at 344.17 172.72 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "1ed84a93-73b9-4935-838e-e820a6236d33"))
(text "PNOZ em partida monitorada e deteccao de curto entre canais." (at 344.17 177.8 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "1e7d68cd-3507-419c-8c5c-92311b417cff"))
